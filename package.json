  "bugs": {
    "url": "https://github.com/jpo-oss/claude-games-server/issues"
  },
  "homepage": "https://github.com/jpo-oss/claude-games-server#readme",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2"
  },
  "version": "0.0.0"
