# Public hostname Caddy serves and gets a certificate for
DOMAIN=games.example.com

# Your GitHub OAuth app (device flow on, no scopes)
GITHUB_CLIENT_ID=your-client-id
GITHUB_CLIENT_SECRET=your-client-secret

# Image tag to run, defaults to latest
# SERVER_VERSION=latest

# Cap on held sync requests
# MAX_HELD=2000

# Players in queue or rooms before "server busy"
# MAX_PLAYERS=1000

# Cap on open connections
# MAX_CONNECTIONS=4000

# Folder with the Daily Diff word files. Compose sets it to /words
# DAILY_DIFF_WORDS_DIR=/words
